						<key>outline</key>
						<string>yes</string>
						<key>style</key>
						<string>Regular</string>
						<key>trademark</key>
						<string>STIX Fonts(TM) is a trademark of The Institute of Electrical and Electronics Engineers, Inc.</string>
						<key>unique</key>
						<string>FontMaster:STIXNonUnicode-Regular:1.1.0</string>
						<key>valid</key>
